{
  "compilerOptions": {
    "target": "ES5",
    "module": "CommonJS",
    "outDir": "./kubejs",
    "rootDir": "./kubejs_src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "kubejs_src/**/*.ts",
    "kubejs_src/**/*.d.ts",
    ".probe/**/*.d.ts"
  ]
}